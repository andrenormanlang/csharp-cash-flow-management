<Window x:Class="CashFlowManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:CashFlowManagement.Enums"
        mc:Ignorable="d"
        Title="Cash-Flow Management"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="WhiteSmoke">
            <MenuItem Header="_File">
                <MenuItem Header="_Save"
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                              Fill="DarkBlue"
                              Stretch="Uniform" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Load"
                          Command="{Binding LoadCommand}"
                          InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2Z"
                              Fill="DarkBlue"
                              Stretch="Uniform" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"
                          InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="_Generate Report"
                          Command="{Binding GenerateReportCommand}" />
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <StackPanel Grid.Column="0"
                        Grid.Row="0">
                <!-- Transaction Input -->
                <GroupBox Header="Add New Transaction"
                          Margin="0,0,0,10">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Date:" />
                        <DatePicker Grid.Row="0"
                                    Grid.Column="1"
                                    SelectedDate="{Binding SelectedDate}"
                                    Margin="5" />

                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="Amount:" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Type:" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  SelectedItem="{Binding SelectedType}"
                                  Margin="5">
                            <enums:CategoryType>Expense</enums:CategoryType>
                            <enums:CategoryType>Revenue</enums:CategoryType>
                        </ComboBox>

                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="Category:" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="3"
                                  ItemsSource="{Binding ExpenseCategories}"
                                  SelectedItem="{Binding SelectedTransactionCategory}"
                                  Margin="5">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger Value="{x:Static enums:CategoryType.Expense}">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedType" />
                                            </DataTrigger.Binding>
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding ExpenseCategories}" />
                                        </DataTrigger>
                                        <DataTrigger Value="{x:Static enums:CategoryType.Revenue}">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedType" />
                                            </DataTrigger.Binding>
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding RevenueCategories}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Content="Description:" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Text="{Binding Description}"
                                 Margin="5" />

                        <Button Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Content="Add Transaction"
                                Command="{Binding AddTransactionCommand}"
                                Background="Green"
                                Foreground="White"
                                Padding="20,10"
                                Margin="5" />
                    </Grid>
                </GroupBox>

                <!-- Search and Filter -->
                <GroupBox Header="Search and Filter"
                          Margin="0,10,0,0">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0"
                               Content="Search:" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" />

                        <Label Grid.Column="2"
                               Content="Month:" />
                        <DatePicker Grid.Column="3"
                                    SelectedDate="{Binding FilterMonth}"
                                    Margin="5" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Category:" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FilterCategory}"
                                  Margin="5" />

                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="Type:" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="3"
                                  SelectedItem="{Binding FilterType}"
                                  Margin="5">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="{x:Static enums:CategoryType.Expense}" />
                            <ComboBoxItem Content="{x:Static enums:CategoryType.Revenue}" />
                        </ComboBox>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <!-- Transactions List -->
            <DataGrid Grid.Column="0"
                      Grid.Row="1"
                      ItemsSource="{Binding Transactions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding Date, StringFormat=d}" />
                    <DataGridTextColumn Header="Amount"
                                        Binding="{Binding Amount, StringFormat=C}" />
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category.Name}" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Category.Type}" />
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          Width="5"
                          HorizontalAlignment="Center" />

            <!-- Monthly Summary -->
            <GroupBox Grid.Column="2"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      Header="Monthly Summary">
                <ScrollViewer>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding FilterMonth, StringFormat=MMMM yyyy}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Total Revenue:"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding MonthlyRevenue, StringFormat=C}"
                                   Foreground="Green"
                                   Margin="10,0,0,10" />

                        <TextBlock Text="Total Expenses:"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding MonthlyExpenses, StringFormat=C}"
                                   Foreground="Red"
                                   Margin="10,0,0,10" />

                        <TextBlock Text="Net Cash Flow:"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding NetCashFlow, StringFormat=C}"
                                   FontWeight="Bold"
                                   Margin="10,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NetCashFlow}"
                                                     Value="0">
                                            <Setter Property="Foreground"
                                                    Value="Black" />
                                        </DataTrigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="NetCashFlow">
                                                    <Binding.Converter>
                                                        <BooleanToVisibilityConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger Value="False">
                                            <DataTrigger.Binding>
                                                <Binding Path="NetCashFlow">
                                                    <Binding.Converter>
                                                        <BooleanToVisibilityConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Top Expense Categories"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding TopExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat=C}"
                                                   Margin="5,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Percentage, StringFormat=P1}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Top Revenue Sources"
                                   FontWeight="Bold"
                                   Margin="0,10,0,5" />
                        <ItemsControl ItemsSource="{Binding TopRevenues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat=C}"
                                                   Margin="5,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Percentage, StringFormat=P1}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- Status Bar -->
            <StatusBar Grid.Row="2"
                       Grid.ColumnSpan="3">
                <StatusBarItem Content="{Binding StatusMessage}" />
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>

