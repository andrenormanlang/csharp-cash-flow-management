<Window
    x:Class="CashFlowManagement.Views.ReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Monthly Financial Report"
    Width="400"
    Height="580"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="20"
                FontWeight="Bold"
                Text="{Binding ReportTitle, StringFormat='Financial Report for {0:dd/MM/yyyy}'}"
                TextAlignment="Center" />

            <GroupBox Margin="0,0,0,15" Header="Revenue Summary">
                <StackPanel Margin="10">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="Top Revenue Sources:" />
                    <ItemsControl ItemsSource="{Binding TopRevenues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Category}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        Text="{Binding Amount, StringFormat=C}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat=P2}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontWeight="Bold"
                        Foreground="Green"
                        Text="{Binding TotalRevenue, StringFormat='Total Revenue: {0:C}'}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,0,0,15" Header="Expense Summary">
                <StackPanel Margin="10">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="Top Expense Categories:" />
                    <ItemsControl ItemsSource="{Binding TopExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Category}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        Text="{Binding Amount, StringFormat=C}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat=P2}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="{Binding TotalExpenses, StringFormat='Total Expenses: {0:C}'}" />
                </StackPanel>
            </GroupBox>

            <Border
                Margin="0,10"
                BorderBrush="Gray"
                BorderThickness="0,1,0,0">
                <TextBlock
                    Margin="0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{Binding NetCashFlow, StringFormat='Net Cash Flow: {0:C}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NetCashFlow}" Value="0">
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="NetCashFlow">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <Binding Path="NetCashFlow">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Button
                Width="100"
                Height="30"
                Margin="0,10"
                Click="CloseButton_Click"
                Content="Close" />
        </StackPanel>
    </Grid>
</Window>