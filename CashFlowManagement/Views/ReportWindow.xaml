<Window x:Class="CashFlowManagement.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Monthly Financial Report"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding ReportTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       TextAlignment="Center"/>

            <GroupBox Header="Revenue Summary" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Top Revenue Sources:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding TopRevenues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Amount, StringFormat=C}" Grid.Column="1" Margin="10,0"/>
                                    <TextBlock Text="{Binding Percentage, StringFormat=P2}" Grid.Column="2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat='Total Revenue: {0:C}'}"
                               FontWeight="Bold"
                               Margin="0,10,0,0"
                               Foreground="Green"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Expense Summary" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Top Expense Categories:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding TopExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Amount, StringFormat=C}" Grid.Column="1" Margin="10,0"/>
                                    <TextBlock Text="{Binding Percentage, StringFormat=P2}" Grid.Column="2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat='Total Expenses: {0:C}'}"
                               FontWeight="Bold"
                               Margin="0,10,0,0"
                               Foreground="Red"/>
                </StackPanel>
            </GroupBox>

            <Border BorderBrush="Gray" 
                    BorderThickness="0,1,0,0" 
                    Margin="0,10">
                <TextBlock Text="{Binding NetCashFlow, StringFormat='Net Cash Flow: {0:C}'}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NetCashFlow}" Value="0">
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="NetCashFlow">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <Binding Path="NetCashFlow">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Button Content="Close"
                    Width="100"
                    Height="30"
                    Margin="0,10"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>